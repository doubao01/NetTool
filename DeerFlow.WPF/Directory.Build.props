<Project>
  <PropertyGroup>
    <!-- DeerFlow.WPF 版本（独立于 SystemToolkit 发布节奏） -->
    <Version>1.4.0</Version>
    <Company>NetTool Team</Company>
    <Product>NetTool</Product>
    <Copyright>Copyright © NetTool Team</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 允许在非 Windows 平台编译 net10.0-windows 目标，Windows 运行仍在 CI 执行 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>