<UserControl x:Class="DeerFlow.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeerFlow.WPF.Views.Controls">

    <Grid Background="{StaticResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙ 系统设置" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColor}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🧪 实验中心" Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,8,0"
                            Command="{Binding ToggleExperimentCenterCommand}"/>
                    <Button Content="📄 文档生成" Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,8,0"
                            Click="ToggleDocumentGeneration_Click"/>
                    <Button Content="📊 刷新状态" Style="{StaticResource SecondaryButton}"
                            Padding="16,8"
                            Command="{Binding RefreshHealthCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 实验中心面板 -->
                <Border Grid.Row="0" x:Name="ExperimentCenterPanel"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,24"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🧪 实验中心" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveExperiments}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="{StaticResource BackgroundColor}"
                                  BorderBrush="{StaticResource BorderColor}"
                                  Margin="0,0,0,20" MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="实验名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="评分" Binding="{Binding Score, StringFormat={}{0:P1}}" Width="80"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="➕ 新建实验" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CreateExperimentCommand}"
                                    Padding="20,10" Margin="0,0,12,0"/>
                            <Button Content="✅ 采纳优胜" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AdoptBestStrategyCommand}"
                                    Padding="20,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 文档生成面板 -->
                <Border Grid.Row="0" x:Name="DocumentGenerationPanel"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,24"
                        Visibility="Collapsed">

                    <local:DocumentPreviewControl/>
                </Border>

                <!-- 系统设置卡片 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.Row="0"
                            Background="{StaticResource CardBackground}"
                            CornerRadius="12" Padding="28" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 卡片标题 -->
                        <TextBlock Grid.Row="0" Text="AI 模型配置" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

                        <!-- 模型提供方 -->
                        <TextBlock Grid.Row="1" Text="模型提供方" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Text="{Binding ModelProvider}" Height="42" FontSize="14"
                                 Margin="0,0,0,20"/>

                        <!-- API Base URL -->
                        <TextBlock Grid.Row="3" Text="API Base URL" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="4" Text="{Binding ApiBaseUrl}" Height="42" FontSize="14"
                                 Margin="0,0,0,20"/>

                        <!-- API Key -->
                        <TextBlock Grid.Row="5" Text="API Key" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ApiKey}" Height="42" FontSize="14"
                                     Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     ToolTip="留空则使用本地推理"/>
                            <PasswordBox Grid.Column="0" x:Name="ApiKeyPasswordBox" Height="42" FontSize="14"
                                         Background="{StaticResource CardBackground}"
                                         Foreground="{StaticResource TextColor}"
                                         BorderBrush="{StaticResource BorderColor}"
                                         BorderThickness="1"
                                         Padding="12,8"
                                         Visibility="{Binding IsApiKeyHidden, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         PasswordChanged="OnApiKeyPasswordChanged"/>
                            <Button Grid.Column="1" Content="Show" Width="42" Height="42" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Padding="0"
                                    Command="{Binding ToggleApiKeyVisibilityCommand}" ToolTip="显示/隐藏密钥"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 功能开关卡片 -->
                <Border Grid.Column="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="功能开关" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

                        <Border Grid.Row="1" Background="{StaticResource ContentBackground}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding EnableLocalInference}"
                                      VerticalContentAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="启用本地推理" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextColor}"/>
                                    <TextBlock Text="数据不上传云端，隐私优先"
                                               FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource ContentBackground}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding EnableSandbox}"
                                      VerticalContentAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="启用 AIO Sandbox 隔离" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextColor}"/>
                                    <TextBlock Text="代码执行环境相互隔离，更安全"
                                               FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Grid.Row="3" Background="{StaticResource ContentBackground}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding AutoSaveMemory}"
                                      VerticalContentAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="自动保存记忆与上下文" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextColor}"/>
                                    <TextBlock Text="跨会话保留对话历史与偏好"
                                               FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Grid.Row="4" Text="修改后请点击下方按钮保存设置"
                                   FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- 当前配置概览卡片 -->
                <Border Grid.Column="0" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,24,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 当前配置概览" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模型提供方：" FontSize="13"
                                       Foreground="{StaticResource TextMutedColor}" Width="90"/>
                            <TextBlock Grid.Column="1" Text="{Binding ModelProvider}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API 地址：" FontSize="13"
                                       Foreground="{StaticResource TextMutedColor}" Width="90"/>
                            <TextBlock Grid.Column="1" Text="{Binding ApiBaseUrl}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API Key：" FontSize="13"
                                       Foreground="{StaticResource TextMutedColor}" Width="90"/>
                            <TextBlock Grid.Column="1" Text="{Binding ApiKeyStatusText}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本地推理：" FontSize="13"
                                       Foreground="{StaticResource TextMutedColor}" Width="90"/>
                            <TextBlock Grid.Column="1" Text="{Binding EnableLocalInference, Converter={StaticResource BooleanToStatusTextConverter}}"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryColor}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 操作按钮区 -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,24,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="💾 保存与重置" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="1" Text="设置将保存到本地配置文件，下次启动时自动加载。恢复默认将清除所有自定义配置。"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                   TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="💾 保存设置" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="28,14" Margin="0,0,12,0"/>
                            <Button Content="🔄 恢复默认" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetSettingsCommand}"
                                    Padding="24,14"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
