<UserControl x:Class="DeerFlow.WPF.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeerFlow.WPF.Views.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Hidden"
                  PanningMode="None">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 欢迎区域 -->
            <Border Grid.Row="0" Background="{StaticResource CardBackground}" 
                    CornerRadius="12" Padding="32" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="28" 
                               FontWeight="Bold" Foreground="{StaticResource TextColor}"/>
                    <TextBlock Text="集成 AIO Sandbox 多窗口任务隔离的桌面 AI 超级助手"
                               FontSize="15" Foreground="{StaticResource TextSecondaryColor}" 
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding QuickStatus}" FontSize="13" 
                               Foreground="{StaticResource AccentColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 快速操作区域 -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="💬" FontSize="32"/>
                        <TextBlock Text="新建对话" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="开始与 AI 智能体对话" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="开始" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewChatCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="🚀" FontSize="32"/>
                        <TextBlock Text="新建任务" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="创建隔离沙箱任务窗口" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="创建" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewTaskCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🛠" FontSize="32"/>
                        <TextBlock Text="技能商店" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="浏览和安装社区技能" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="浏览" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenSkillsCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 健康监控仪表盘 -->
            <local:HealthMonitorControl Grid.Row="2" Margin="0,0,0,24"
                                        DataContext="{Binding}"/>

            <!-- 最近任务 -->
            <Border Grid.Row="3" Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📋 最近任务" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}"/>
                        <Button Grid.Column="1" Content="🔄 刷新" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Command="{Binding RefreshHealthCommand}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundColor}"
                                        CornerRadius="6" Padding="16" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextColor}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}"
                                                   FontSize="12" Foreground="{StaticResource AccentColor}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
