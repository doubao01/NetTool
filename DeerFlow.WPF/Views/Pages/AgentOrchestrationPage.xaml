<UserControl x:Class="DeerFlow.WPF.Views.Pages.AgentOrchestrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <TextBlock Text="&#x1F916; 智能体编排" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"/>
        </Border>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 编排配置卡片 -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,0,12,0">
                    <Grid>
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>

                        <!-- 卡片标题 -->
                        <TextBlock Grid.Row="0" Text="编排配置" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

                        <!-- 编排名称 -->
                        <TextBlock Grid.Row="1" Text="编排名称" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Text="{Binding WorkflowName}" Height="42" FontSize="14"
                                 Margin="0,0,0,20"/>

                         <!-- 总体目标 -->
                         <TextBlock Grid.Row="3" Text="总体目标（可选）" FontSize="13"
                                    Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                         <TextBox Grid.Row="4" Text="{Binding Goal}" Height="42" FontSize="14"
                                  Margin="0,0,0,20"/>

                         <!-- 编排步骤描述 -->
                         <TextBlock Grid.Row="5" Text="编排步骤（每行一步）" FontSize="13"
                                    Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                         <TextBox Grid.Row="6" Text="{Binding WorkflowSteps}" Height="100"
                                  TextWrapping="Wrap" AcceptsReturn="True"
                                  FontSize="14" Margin="0,0,0,20"/>

                         <!-- 最大子智能体数 -->
                         <TextBlock Grid.Row="7" Text="最大子智能体数" FontSize="13"
                                    Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                         <Grid Grid.Row="8" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Width="120">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="-" Width="32" Height="32"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="16" FontWeight="Bold"
                                            Padding="0"
                                            Command="{Binding DecreaseMaxSubAgentsCommand}"/>
                                    <TextBox Grid.Column="1" Text="{Binding MaxSubAgents, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="16" FontWeight="SemiBold"
                                             Foreground="{StaticResource TextColor}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0"/>
                                    <Button Grid.Column="2" Content="+" Width="32" Height="32"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="16" FontWeight="Bold"
                                            Padding="0"
                                            Command="{Binding IncreaseMaxSubAgentsCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="建议设置 2-5 个，根据任务复杂度调整"
                                       FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>

                         <!-- 操作按钮 -->
                         <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,8,0,0">
                             <Button Content="保存编排" Style="{StaticResource PrimaryButton}"
                                     Command="{Binding CreateWorkflowCommand}" Margin="0,0,12,0"
                                     Padding="24,12"/>
                             <Button Content="AI 分解步骤" Style="{StaticResource SecondaryButton}"
                                     Command="{Binding PlanSubGoalsCommand}"
                                     Padding="24,12" Margin="0,0,12,0"/>
                             <Button Content="启动执行" Style="{StaticResource PrimaryButton}"
                                     Command="{Binding StartWorkflowCommand}"
                                     Padding="24,12" Margin="0,0,12,0"/>
                             <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                     Command="{Binding CancelWorkflowCommand}"
                                     Padding="24,12"/>
                         </StackPanel>
                    </Grid>
                </Border>

                <!-- 执行历史卡片 -->
                <Border Grid.Column="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="执行历史" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Text="每次编排运行自动落库，可回看轨迹与结果"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,0,0,20" TextWrapping="Wrap"/>

                        <ListBox Grid.Row="2" ItemsSource="{Binding HistoryLog}"
                                 SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                                 MaxHeight="260" MinHeight="120"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="加载轨迹" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LoadSelectedHistoryCommand}"
                                    Padding="18,8" Margin="0,0,8,0"/>
                            <Button Content="删除记录" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteSelectedHistoryCommand}"
                                    Padding="18,8" Margin="0,0,8,0"/>
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshHistoryCommand}"
                                    Padding="18,8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 编排状态概览卡片 -->
                <Border Grid.Column="0" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,24,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                         <TextBlock Grid.Row="0" Text="编排状态" FontSize="18" FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                         <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="14"
                                    Foreground="{StaticResource TextSecondaryColor}"
                                    TextWrapping="Wrap" Margin="0,0,0,12"/>

                         <ItemsControl Grid.Row="2" ItemsSource="{Binding ExecutionLog}"
                                       MaxHeight="180">
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                     <TextBlock Text="{Binding}" FontSize="12"
                                                Foreground="{StaticResource TextMutedColor}"
                                                TextWrapping="Wrap" Margin="0,0,0,4"/>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                         </ItemsControl>
                    </Grid>
                </Border>

                <!-- 快速提示卡片 -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,24,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                         <TextBlock Grid.Row="0" Text="执行结果" FontSize="18" FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                         <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}"
                                  IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                  Height="180" FontSize="13"
                                  VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
