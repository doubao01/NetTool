<UserControl x:Class="DeerFlow.WPF.Views.Controls.HealthMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource CardBackground}" 
            CornerRadius="12" Padding="24">
        <StackPanel>
            <TextBlock Text="📊 系统健康状态" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

            <!-- 模式库状态 -->
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="模式库" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PatternCount}" 
                               FontSize="14" Foreground="{StaticResource TextMutedColor}"/>
                </Grid>
                <ProgressBar Value="{Binding PatternCount}" Maximum="100" 
                             Height="6" Margin="0,4,0,0"
                             Style="{StaticResource ProgressBarStyle}"/>
            </StackPanel>

            <!-- 经验记忆状态 -->
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="经验记忆" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ExperienceCount}" 
                               FontSize="14" Foreground="{StaticResource TextMutedColor}"/>
                </Grid>
                <ProgressBar Value="{Binding ExperienceCount}" Maximum="100" 
                             Height="6" Margin="0,4,0,0"
                             Style="{StaticResource ProgressBarStyle}"/>
            </StackPanel>

            <!-- 实验进度 -->
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="进行中实验" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveExperimentCount}" 
                               FontSize="14" Foreground="{StaticResource TextMutedColor}"/>
                </Grid>
                <ProgressBar Value="{Binding ActiveExperimentCount}" Maximum="10" 
                             Height="6" Margin="0,4,0,0"
                             Style="{StaticResource ProgressBarStyle}"/>
            </StackPanel>

            <!-- 最近的反思 -->
            <TextBlock Text="📝 最近反思" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextColor}" Margin="0,16,0,8"/>
            <ItemsControl ItemsSource="{Binding RecentReflections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A2B3C" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TaskType}" FontSize="12"
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource PrimaryColor}"/>
                                    <TextBlock Text="{Binding TaskDescription}" FontSize="11"
                                               Foreground="{StaticResource TextMutedColor}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="10" 
                                               Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibility}}"/>
                                    <TextBlock Text="❌" FontSize="10" 
                                               Visibility="{Binding IsSuccess, Converter={StaticResource InverseBooleanToVisibility}}"/>
                                    <TextBlock Text="{Binding ExecutionTimeMs, StringFormat='{}{0}ms'}" 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextMutedColor}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 刷新按钮 -->
            <Button Content="🔄 刷新" Command="{Binding RefreshHealthCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
