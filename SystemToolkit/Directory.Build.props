<Project>
  <PropertyGroup>
    <!-- SystemToolkit 版本（DeerFlow.WPF 继承仓库级默认 1.3.0） -->
    <Version>1.4.0</Version>
    <Company>NetTool Team</Company>
    <Product>NetTool</Product>
    <Copyright>Copyright © NetTool Team</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 允许在非 Windows 平台编译 net10.0-windows 目标，Windows 运行仍在 CI 执行 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
